{
  "name": "BlogBoard Automated Content Publishing & Webhook Trigger",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger (Daily at 9 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"dry_run\": false\n}",
        "options": {}
      },
      "id": "2",
      "name": "Trigger BlogBoard API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Daily at 9 AM)": {
      "main": [
        [
          {
            "node": "Trigger BlogBoard API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
